.wq-quiz .wq-feedback.wq-ok { color: #22863a; }
.wq-quiz .wq-feedback.wq-bad { color: #d73a49; }
.wq-quiz button.wq-next { margin-top: 16px; font-family: inherit; font-size: 16px; padding: 10px 32px; border: none; border-radius: 10px; background: #19768c; color: #fff; cursor: pointer; box-shadow: 0 4px 12px rgba(25,118,140,.35); }
.wq-quiz button.wq-next:hover { background: #00677f; }
