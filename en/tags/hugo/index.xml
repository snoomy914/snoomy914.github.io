.wq-quiz button.wq-opt { display: block; width: 100%; font-family: inherit; font-size: 16px; line-height: 1.7; text-align: left; padding: 12px 16px; border: 2px solid #99c2cc; border-radius: 10px; background: #fff; color: #24292e; cursor: pointer; transition: transform .08s, border-color .15s, background .15s; box-shadow: none; }
