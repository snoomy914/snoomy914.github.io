    <item>
      <title>Reimu 主题下的 i18n</title>
      <link>https://qzchen.top/zh-tw/post/hugo-reimu-i18n/</link>
      <pubDate>Sat, 01 Aug 2026 17:15:02 &#43;0800</pubDate>
      <author>chankeichow2008@outlook.com (Snoomy)</author>
